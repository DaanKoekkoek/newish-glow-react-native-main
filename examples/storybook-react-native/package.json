{
  "private": true,
  "name": "@odido-portals/glow-storybook-react-native",
  "main": "index.js",
  "license": "Apache-2.0",
  "scripts": {
    "clear-cache": "expo start --clear --dev-client",
    "android": "expo run:android",
    "eject": "expo eject",
    "ios": "expo run:ios",
    "storybook-generate": "sb-rn-get-stories --config-path .storybook-rn",
    "storybook-rn:android": "expo run:android",
    "storybook-rn:ios": "expo run:ios",
    "storybook-rn:web": "cross-env STORYBOOK_ENABLED='true' expo start",
    "storybook:web": "cross-env SB_MODE=swc storybook dev -p 6007",
    "storybook:web-old": "storybook dev -p 6007",
    "storybook:web-build": "cross-env SB_MODE=swc storybook build",
    "build-storybook": "storybook build",
    "chromatic": "dotenv -- cross-var npx chromatic --project-token=%STORYBOOK_TOKEN%"
  },
  "dependencies": {
