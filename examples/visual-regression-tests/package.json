{
  "name": "@odido-portals/glow-visual-regression-tests",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "build-lib": "pnpm --filter \"@odido-portals/glow-react-native\" run build",
    "build:vrt:types": "pnpm run build-lib && tsc --project tsconfig.json",
    "start": "expo start",
    "android": "expo run:android",
    "android-clean": "pnpm android --no-build-cache",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "owl:android-build": "pnpm build-lib && owl build --platform android",
    "owl:android-test": "owl test --platform android",
    "owl:android-update": "pnpm owl:android-test --update && pnpm vrt-validate-update --platform=android --output-diff=true",
    "---": "below ------------ used by other scripts",
    "vrt-validate-update": "pnpx tsx ./scripts/vrtValidateUpdate.ts"
  },
  "dependencies": {
    "@odido-portals/glow-react-native": "workspace:*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/slider": "4.5.2",
    "@react-native-picker/picker": "2.6.1",
    "@react-navigation/native": "6.1.18",
    "@react-navigation/native-stack": "6.11.0",
    "expo": "catalog:current",
    "expo-asset": "catalog:current",
    "expo-constants": "catalog:current",
    "expo-linear-gradient": "catalog:current",
    "expo-status-bar": "catalog:current",
    "react": "catalog:current",
    "react-dom": "catalog:current",
    "react-native": "catalog:current",
    "react-native-fast-shadow": "catalog:current",
    "react-native-gesture-handler": "catalog:current",
    "react-native-reanimated": "catalog:current",
    "react-native-safe-area-context": "catalog:current",
    "react-native-screens": "^3.29.0",
    "react-native-svg": "catalog:current",
    "react-native-unistyles": "catalog:current",
    "react-native-web": "catalog:current",
    "react-native-web-hooks": "catalog:current"
  },
  "devDependencies": {
    "@babel/core": "catalog:current",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "catalog:current",
    "@types/yargs": "^17.0.32",
    "babel-loader": "catalog:current",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-react-docgen-typescript": "^1.5.1",
    "babel-plugin-react-native-web": "^0.19.12",
    "ora": "^8.0.1",
    "pixelmatch": "^6.0.0",
    "pngjs": "^6.0.0",
    "react-native-owl": "^1.4.0",
    "typescript": "catalog:current",
    "yargs": "^17.7.2"
  },
  "private": true
}
