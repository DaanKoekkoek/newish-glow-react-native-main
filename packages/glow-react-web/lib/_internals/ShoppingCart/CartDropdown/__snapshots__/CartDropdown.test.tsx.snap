exports[`<CartDropdown /> renders a stable snapshot when empty 1`] = `
<div>
  <div
    class="cart-dropdown"
  >
    <div>
      <div
        class="cart-dropdown-empty cart-dropdown-palette-default"
        tabindex="0"
      >
        <span
          aria-hidden="true"
          class="icon icon-size-lg outline cart-dropdown-icon"
          data-icon="shop"
          data-testid="icon"
        >
          
        </span>
        <p
          class="paragraph paragraph-size-sm cart-dropdown-empty-title"
          data-testid="paragraph"
        >
          Je winkelwagen is leeg
        </p>
      </div>
    </div>
    <hr
      class="divider divider-prominence-subtle divider-variant-default"
      data-testid="divider"
    />
    <div
      class="cart-dropdown-footer"
      tabindex="0"
    >
      <button
        class="fill button button-size-default button-prominence-default"
        data-testid="button"
      >
        <span
          class="button-label"
        >
          Naar winkelwagen
        </span>
      </button>
    </div>
  </div>
</div>
`;

