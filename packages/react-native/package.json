    "@babel/cli": "^7.24.8",
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.24.7",
    "@storybook/react": "^7.6.20",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react-native": "^12.4.4",
    "@types/highlight-words-core": "^1.2.3",
    "@types/jest": "^29.5.12",
    "@types/react": "catalog:current",
    "babel-plugin-module-resolver": "^5.0.2",
    "jest": "^29.7.0",
    "jest-expo": "catalog:current",
    "jest-junit": "^16.0.0",
    "plop": "^4.0.1",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "catalog:current"
  },
